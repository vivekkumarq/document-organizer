# ---------------------------------------------------------------------------
# Copy to .env and adjust. docker-compose.yml reads this file automatically.
# Running the backend outside Docker? Export these as environment variables.
# ---------------------------------------------------------------------------

# --- PostgreSQL (consumed by the db service and by the backend) -------------
POSTGRES_DB=docorganizer
POSTGRES_USER=docorganizer
POSTGRES_PASSWORD=change-me-in-production

# --- Backend datasource ----------------------------------------------------
# Outside Docker use: jdbc:postgresql://localhost:5432/docorganizer
DB_URL=jdbc:postgresql://db:5432/docorganizer
DB_USERNAME=docorganizer
DB_PASSWORD=change-me-in-production

# Hibernate schema handling: update | validate | none.
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# --- Authentication --------------------------------------------------------
# HMAC-SHA256 signing secret. MUST be at least 32 characters; the app refuses
# to start with a shorter one. Leaving it empty generates a random key at
# startup, which invalidates every issued token on restart - dev only.
# Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-characters

# Token lifetime in milliseconds. Default 86400000 (24 hours).
JWT_EXPIRATION_MS=86400000

# --- Storage ---------------------------------------------------------------
# Directory documents are written to. Inside the backend image this is
# /app/storage, which is backed by the docorganizer_storage named volume.
STORAGE_DIR=/app/storage

# Per-user storage allowance in bytes. Default 104857600 (100 MiB).
STORAGE_QUOTA_BYTES=104857600

# Largest single upload in bytes. Default 10485760 (10 MiB).
STORAGE_MAX_FILE_SIZE_BYTES=10485760

# Servlet container limits. Keep these above STORAGE_MAX_FILE_SIZE_BYTES so an
# oversized upload fails with a JSON 413 instead of a container-level error.
MAX_UPLOAD_SIZE=16MB
MAX_REQUEST_SIZE=20MB

# --- HTTP ------------------------------------------------------------------
SERVER_PORT=8080

# Comma-separated browser origins allowed to call the API.
# Docker Compose serves the UI on http://localhost:5173.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Log level for application classes: TRACE | DEBUG | INFO | WARN | ERROR.
LOG_LEVEL=INFO

# --- Frontend (build-time only; Vite inlines VITE_* at build) ---------------
VITE_API_BASE_URL=http://localhost:8080
